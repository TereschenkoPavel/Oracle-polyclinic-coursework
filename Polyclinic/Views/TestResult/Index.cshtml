@using Clinic.Models;
@model List<TestResultModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Результаты анализов";
}

<h1>Результаты анализов</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="input-group">
            <input type="text" name="searchTerm" class="form-control" placeholder="Поиск по ФИО..." value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-primary">Поиск</button>
            <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
        </form>
    </div>
    @if (User.IsInRole("DOCTOR") || User.IsInRole("HEAD_DOCTOR"))
    {
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-success">Добавить результат</a>
        </div>
    }
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Пациент</th>
                    <th>Тип анализа</th>
                    <th>Дата анализа</th>
                    <th>Дата результата</th>
                    <th>Результат</th>
                    <th>Нормальные значения</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td>@result.ResultId</td>
                        <td>
                            <div><strong>ID: @result.PatientId</strong></div>
                            @if (!string.IsNullOrEmpty(result.PatientFullName))
                            {
                                <small class="text-muted">@result.PatientFullName</small>
                            }
                            else
                            {
                                <small class="text-muted">ФИО не указано</small>
                            }
                        </td>
                        <td>@result.TestType</td>
                        <td>@result.TestDate.ToString("dd.MM.yyyy")</td>
                        <td>@result.ResultDate.ToString("dd.MM.yyyy")</td>
                        <td>@result.ResultValue</td>
                        <td>@result.NormalRange</td>
                        <td>
                            @if (User.IsInRole("HEAD_DOCTOR") || User.IsInRole("DOCTOR") )
                            {
                                <a asp-action="Edit" asp-route-id="@result.ResultId" class="btn btn-sm btn-warning">Редактировать</a>
                                <a asp-action="Delete" asp-route-id="@result.ResultId" class="btn btn-sm btn-danger">Удалить</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Результаты анализов не найдены.
        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
        {
            <span>Попробуйте изменить поисковый запрос.</span>
        }
    </div>
}