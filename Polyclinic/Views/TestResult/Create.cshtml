@using Clinic.Models;
@model TestResultModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Добавить результат анализа";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="testResultForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="PatientId" class="control-label"></label>
                                <select asp-for="PatientId"
                                        class="form-control"
                                        id="patientSelect"
                                        required>
                                    <option value="">-- Выберите пациента --</option>
                                    @if (Model.Patients != null)
                                    {
                                        @foreach (var patient in Model.Patients)
                                        {
                                            <option value="@patient.PatientId">@patient.FullName (ID: @patient.PatientId)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PatientId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="TestType" class="control-label"></label>
                                <input asp-for="TestType" class="form-control" placeholder="Например: Общий анализ крови" />
                                <span asp-validation-for="TestType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="TestDate" class="control-label"></label>
                                <input asp-for="TestDate" class="form-control" type="date" />
                                <span asp-validation-for="TestDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ResultDate" class="control-label">Дата результата</label>
                                <input asp-for="ResultDate" class="form-control" type="date" />
                                <span asp-validation-for="ResultDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label asp-for="ResultValue" class="control-label"></label>
                                <input asp-for="ResultValue" class="form-control" placeholder="Например: 5.2 г/дл" />
                                <span asp-validation-for="ResultValue" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="NormalRange" class="control-label"></label>
                                <input asp-for="NormalRange" class="form-control" placeholder="Например: 4.0-6.0 г/дл" />
                                <span asp-validation-for="NormalRange" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Добавить результат</button>
                        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Инициализация select2 для удобного выбора пациента
            $('#patientSelect').select2({
                placeholder: 'Выберите пациента',
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}