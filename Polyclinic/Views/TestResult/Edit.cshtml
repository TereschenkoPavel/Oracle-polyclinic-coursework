@using Clinic.Models;
@model TestResultModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Редактировать результат анализа";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="ResultId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="PatientId" class="control-label"></label>
                                <input asp-for="PatientId" 
                                       class="form-control" 
                                       id="patientIdInput"
                                       type="number"
                                       min="1" />
                                <span asp-validation-for="PatientId" class="text-danger"></span>
                                <div id="patientInfo" class="mt-2">
                                    @if (!string.IsNullOrEmpty(Model.PatientFullName))
                                    {
                                        <small class="text-success" id="patientNameDisplay">
                                            <strong>@Model.PatientFullName</strong>
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted" id="patientNameDisplay">
                                            Введите ID пациента для отображения ФИО
                                        </small>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="TestType" class="control-label"></label>
                                <input asp-for="TestType" class="form-control" placeholder="Например: Общий анализ крови" />
                                <span asp-validation-for="TestType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="TestDate" class="control-label"></label>
                                <input asp-for="TestDate" class="form-control" type="date" />
                                <span asp-validation-for="TestDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ResultDate" class="control-label">Дата результата</label>
                                <input asp-for="ResultDate" class="form-control" type="date" />
                                <span asp-validation-for="ResultDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label asp-for="ResultValue" class="control-label"></label>
                                <input asp-for="ResultValue" class="form-control" placeholder="Например: 5.2 г/дл" />
                                <span asp-validation-for="ResultValue" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="NormalRange" class="control-label"></label>
                                <input asp-for="NormalRange" class="form-control" placeholder="Например: 4.0-6.0 г/дл" />
                                <span asp-validation-for="NormalRange" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-warning">Сохранить изменения</button>
                        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Дебаунс для уменьшения количества запросов
            let timeoutId;
            
            $('#patientIdInput').on('input', function() {
                clearTimeout(timeoutId);
                const patientId = $(this).val().trim();
                
                if (!patientId || patientId < 1) {
                    $('#patientNameDisplay').html('<span class="text-muted">Введите ID пациента для отображения ФИО</span>');
                    return;
                }
                
                timeoutId = setTimeout(function() {
                    fetchPatientInfo(patientId);
                }, 500);
            });
            
            $('#patientIdInput').on('blur', function() {
                const patientId = $(this).val().trim();
                if (patientId && patientId >= 1) {
                    fetchPatientInfo(patientId);
                }
            });
            
            function fetchPatientInfo(patientId) {
                $('#patientNameDisplay').html('<span class="text-info">Загрузка...</span>');
                
                $.ajax({
                    url: '@Url.Action("GetPatientInfo", "TestResult")',
                    type: 'GET',
                    data: { id: patientId },
                    success: function(response) {
                        if (response.success) {
                            $('#patientNameDisplay').html('<span class="text-success"><strong>' + response.fullName + '</strong></span>');
                        } else {
                            $('#patientNameDisplay').html('<span class="text-danger">' + response.message + '</span>');
                        }
                    },
                    error: function() {
                        $('#patientNameDisplay').html('<span class="text-danger">Ошибка соединения с сервером</span>');
                    }
                });
            }
            
            // При загрузке страницы, если уже есть ID, загружаем информацию
            const initialPatientId = $('#patientIdInput').val();
            if (initialPatientId && initialPatientId >= 1) {
                fetchPatientInfo(initialPatientId);
            }
        });
    </script>
}