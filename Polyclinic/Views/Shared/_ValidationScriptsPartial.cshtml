@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var environment = Configuration["ASPNETCORE_ENVIRONMENT"] ?? "Production";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
        $(document).ready(function() {
            // Руссификация сообщений валидации
        $.validator.setDefaults({
                highlight: function(element) {
                    $(element).addClass('is-invalid').removeClass('is-valid');
                },
                unhighlight: function(element) {
                    $(element).removeClass('is-invalid').addClass('is-valid');
                },
                errorElement: 'div',
                errorClass: 'invalid-feedback',
                errorPlacement: function(error, element) {
                    if (element.parent('.input-group').length) {
                        error.insertAfter(element.parent());
                    } else if (element.prop('type') === 'checkbox' || element.prop('type') === 'radio') {
                        error.appendTo(element.parent().parent());
                    } else {
                        error.insertAfter(element);
                    }
                }
            });
        $.validator.addMethod("validAppointmentTime", function(value, element) {
            if (this.optional(element)) return true;

            var doctorId = $('#doctorSelect').val();
            var appointmentDate = $('#appointmentDateTime').val();

            if (!doctorId || !appointmentDate) {
                return false;
            }

            var isValid = false;
            $.ajax({
                url: '@Url.Action("ValidateAppointmentTime", "DoctorSchedule")',
                type: 'POST',
                async: false,
                contentType: 'application/json',
                data: JSON.stringify({
                    doctorId: doctorId,
                    proposedTime: appointmentDate
                }),
                success: function(response) {
                    isValid = response.success && response.isValid;
                }
            });

            return isValid;
        }, "Выбранное время недоступно для записи");
        // Кастомные правила валидации
        $.validator.addMethod("phone", function(value, element) {
            return this.optional(element) || /^[\d\s\-\+\(\)]+$/.test(value);
        }, "Пожалуйста, введите корректный номер телефона");

        $.validator.addMethod("passport", function(value, element) {
            return this.optional(element) || /^[A-Z]{2}\d{7}$/.test(value);
        }, "Формат паспорта: AA1234567");

        $.validator.addMethod("date", function(value, element) {
            return this.optional(element) || /^\d{4}-\d{2}-\d{2}$/.test(value);
        }, "Формат даты: ГГГГ-ММ-ДД");

        $.validator.addMethod("futureDate", function(value, element) {
            if (this.optional(element)) return true;
            var selectedDate = new Date(value);
            var now = new Date();
            now.setHours(0, 0, 0, 0);
            return selectedDate >= now;
        }, "Дата должна быть сегодня или позже");

        $.validator.addMethod("time", function(value, element) {
            return this.optional(element) || /^([01]\d|2[0-3]):([0-5]\d)$/.test(value);
        }, "Формат времени: ЧЧ:ММ");

        // Применение правил к формам
        $('form').each(function() {
            var form = $(this);

            // Автоматическое добавление правил на основе атрибутов
            form.find('[data-val-phone]').rules('add', {
                phone: true
            });

            form.find('[data-val-passport]').rules('add', {
                passport: true
            });

            form.find('[data-val-futuredate]').rules('add', {
                futureDate: true
            });

            form.find('[type="date"]').rules('add', {
                date: true
            });

            form.find('[type="datetime-local"]').rules('add', {
                date: true
            });

            // Валидация обязательных полей select
            form.find('select[required]').each(function() {
                $(this).rules('add', {
                    required: true,
                    messages: {
                        required: "Это поле обязательно для выбора"
                    }
                });
            });
        });

        // Динамическое обновление валидации
        $(document).on('change', 'input, select, textarea', function() {
            var form = $(this).closest('form');
            if ($.data(form[0], 'validator')) {
                form.validate().element(this);
            }
        });

        // Обработка отправки формы
        $(document).on('submit', 'form', function(e) {
            var form = $(this);
            var validator = form.validate();

            if (!validator.form()) {
                e.preventDefault();

                // Прокрутка к первой ошибке
                var firstError = form.find('.field-validation-error:visible').first();
                if (firstError.length) {
                    $('html, body').animate({
                        scrollTop: firstError.offset().top - 100
                    }, 500);
                }

                return false;
            }

            // Блокировка кнопки отправки
            var submitButton = form.find('[type="submit"]');
            if (submitButton.length) {
                submitButton.prop('disabled', true).html(
                    '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Отправка...'
                );
            }
        });

        // Показ всех ошибок формы
        window.showFormErrors = function(formId) {
            var form = $('#' + formId);
            var validator = form.validate();
            validator.form();

            // Показ всех сообщений
            form.find('.field-validation-error').show();

            // Прокрутка к первой ошибке
            var firstError = form.find('.field-validation-error:visible').first();
            if (firstError.length) {
                $('html, body').animate({
                    scrollTop: firstError.offset().top - 100
                }, 500);
            }
        };
    });
</script>

<style>
    .field-validation-error {
        display: none;
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .field-validation-valid {
        display: none;
    }

    .input-validation-error {
        border-color: #dc3545;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .is-valid {
        border-color: #28a745;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2328a745' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .is-invalid {
        border-color: #dc3545;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .validation-summary-errors {
        color: #721c24;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 0.25rem;
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
    }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 1.5rem;
        }

        .validation-summary-errors li {
            margin-bottom: 0.25rem;
        }

    .spinner-border {
        vertical-align: middle;
        margin-right: 0.5rem;
    }
</style>