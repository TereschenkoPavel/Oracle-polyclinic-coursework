﻿@using Clinic.Models;
@model MedicalRecordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Создание медицинской записи";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="PatientId" class="control-label"></label>
                                <select asp-for="PatientId"
                                        class="form-control"
                                        id="patientSelect"
                                        required>
                                    <option value="">-- Выберите пациента --</option>
                                    @foreach (var patient in Model.Patients)
                                    {
                                        <option value="@patient.PatientId">@patient.FullName</option>
                                    }
                                </select>
                                <span asp-validation-for="PatientId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="DoctorId" class="control-label"></label>
                                <select asp-for="DoctorId"
                                        class="form-control"
                                        id="doctorSelect"
                                        required>
                                    <option value="">-- Выберите врача --</option>
                                    @foreach (var doctor in Model.Doctors)
                                    {
                                        <option value="@doctor.DoctorId">@doctor.FullName</option>
                                    }
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Diagnosis" class="control-label"></label>
                        <textarea asp-for="Diagnosis"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Введите диагноз"
                                  required></textarea>
                        <span asp-validation-for="Diagnosis" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Prescription" class="control-label"></label>
                        <textarea asp-for="Prescription"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Введите назначения (лечение, рекомендации)"></textarea>
                        <span asp-validation-for="Prescription" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Notes" class="control-label"></label>
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Дополнительные заметки"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Создать запись
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Отмена
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Инициализация select2 для удобного выбора
            $('#patientSelect').select2({
                placeholder: 'Выберите пациента',
                allowClear: true,
                width: '100%'
            });

            $('#doctorSelect').select2({
                placeholder: 'Выберите врача',
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}