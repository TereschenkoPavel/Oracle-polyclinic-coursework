﻿@using Clinic.Models;
@model List<MedicalRecordModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Медицинские записи";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-3">
    <div class="col-md-12 text-end">
        @if (User.IsInRole("DOCTOR") || User.IsInRole("HEAD_DOCTOR"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-file-medical-alt"></i> Новая медицинская запись
            </a>
        }
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Пациент</th>
                    <th>Врач</th>
                    <th>Диагноз</th>
                    <th>Назначение</th>
                    <th>Заметки</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>
                            <div>@record.RecordDate.ToString("dd.MM.yyyy")</div>
                            <small class="text-muted">@record.RecordDate.ToString("HH:mm")</small>
                        </td>
                        <td>
                            <div><strong>@record.PatientName</strong></div>
                            <small class="text-muted">ID: @record.PatientId</small>
                        </td>
                        <td>
                            <div>@record.DoctorName</div>
                            <small class="text-muted">ID: @record.DoctorId</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(record.Diagnosis))
                            {
                                <span class="badge bg-danger">@record.Diagnosis</span>
                            }
                            else
                            {
                                <span class="text-muted">не указан</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(record.Prescription))
                            {
                                <div class="truncate-text" title="@record.Prescription">
                                    @(record.Prescription.Length > 50 ? record.Prescription.Substring(0, 50) + "..." : record.Prescription)
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">нет</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(record.Notes))
                            {
                                <div class="truncate-text" title="@record.Notes">
                                    @(record.Notes.Length > 50 ? record.Notes.Substring(0, 50) + "..." : record.Notes)
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">нет</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@record.RecordId"
                                   class="btn btn-sm btn-outline-primary" title="Подробнее">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (User.IsInRole("DOCTOR") || User.IsInRole("HEAD_DOCTOR"))
                                {
                                    <a asp-action="Edit" asp-route-id="@record.RecordId"
                                       class="btn btn-sm btn-outline-warning" title="Редактировать">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@record.RecordId"
                                       class="btn btn-sm btn-outline-danger" title="Удалить">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-file-medical"></i> Медицинские записи не найдены.
    </div>
}

@section Styles {
    <style>
        .truncate-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 150px;
            cursor: help;
        }

        .badge {
            max-width: 200px;
            white-space: normal;
            word-wrap: break-word;
        }
    </style>
}