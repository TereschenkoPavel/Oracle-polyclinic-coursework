﻿@using Clinic.Models;
@model MedicalRecordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Детали медицинской записи";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5>Основная информация</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">ID записи:</dt>
                                    <dd class="col-sm-8">@Model.RecordId</dd>

                                    <dt class="col-sm-4">Дата создания:</dt>
                                    <dd class="col-sm-8">@Model.RecordDate.ToString("dd.MM.yyyy HH:mm")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5>Информация о пациенте</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">ID пациента:</dt>
                                    <dd class="col-sm-8">@Model.PatientId</dd>

                                    <dt class="col-sm-4">ФИО пациента:</dt>
                                    <dd class="col-sm-8">@Model.PatientName</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5>Информация о враче</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">ID врача:</dt>
                                    <dd class="col-sm-8">@Model.DoctorId</dd>

                                    <dt class="col-sm-4">ФИО врача:</dt>
                                    <dd class="col-sm-8">@Model.DoctorName</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5>Медицинская информация</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Диагноз:</label>
                            <div class="border p-3 rounded bg-light">
                                @if (!string.IsNullOrEmpty(Model.Diagnosis))
                                {
                                    <p class="mb-0">@Model.Diagnosis</p>
                                }
                                else
                                {
                                    <p class="mb-0 text-muted">Диагноз не указан</p>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Назначения:</label>
                            <div class="border p-3 rounded bg-light">
                                @if (!string.IsNullOrEmpty(Model.Prescription))
                                {
                                    <p class="mb-0">@Model.Prescription</p>
                                }
                                else
                                {
                                    <p class="mb-0 text-muted">Назначения отсутствуют</p>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Заметки:</label>
                            <div class="border p-3 rounded bg-light">
                                @if (!string.IsNullOrEmpty(Model.Notes))
                                {
                                    <p class="mb-0">@Model.Notes</p>
                                }
                                else
                                {
                                    <p class="mb-0 text-muted">Заметки отсутствуют</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Назад к списку
                    </a>
                    @if (User.IsInRole("HEAD_DOCTOR") || User.IsInRole("DOCTOR"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.RecordId" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Редактировать
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>