@using Clinic.Models;
@model UserModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Смена пароля регистратора";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <h5>Информация о пользователе:</h5>
                    <p><strong>Логин:</strong> @Model.Username</p>
                    <p><strong>Роль:</strong> @Model.Role</p>
                </div>

                <form asp-action="EditPassword" method="post">
                    <input type="hidden" asp-for="UserId" value=@Model.UserId />
                    <input type="hidden" asp-for="Username" value=@Model.Username />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="control-label">Новый пароль</label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <small class="form-text text-muted">Минимум 6 символов</small>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ConfirmPassword" class="control-label">Подтвердите новый пароль</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-warning">Обновить пароль</button>
                        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}