
@using Clinic.Models;
@model List<PatientModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Пациенты";
}

<h1>Список пациентов</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="input-group">
            <input type="text" name="searchTerm" class="form-control" placeholder="Поиск по ФИО..." value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-primary">Поиск</button>
            <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
        </form>
    </div>
    @if (User.IsInRole("REGISTRAR") || User.IsInRole("HEAD_DOCTOR"))
    {
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-success">Добавить пациента</a>
        </div>
    }
</div>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Дата рождения</th>
                <th>Телефон</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.PatientId</td>
                    <td>@patient.LastName</td>
                    <td>@patient.FirstName</td>
                    <td>@patient.MiddleName</td>
                    <td>@patient.BirthDate.ToString("dd.MM.yyyy")</td>
                    <td>@patient.Phone</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@patient.PatientId" class="btn btn-sm btn-info">Подробнее</a>
                        @if (User.IsInRole("REGISTRAR") || User.IsInRole("HEAD_DOCTOR"))
                        {
                            <a asp-action="Edit" asp-route-id="@patient.PatientId" class="btn btn-sm btn-warning">Редактировать</a>
                            <a asp-action="Delete" asp-route-id="@patient.PatientId" class="btn btn-sm btn-danger">Удалить</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        Пациенты не найдены.
    </div>
}