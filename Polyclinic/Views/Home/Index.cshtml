@{
    Layout = "_Layout";
    ViewData["Title"] = "Главная";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center">
    <h1 class="display-4">Добро пожаловать в Клинику</h1>
    <p>Система управления медицинским учреждением</p>

    @if (!User.Identity.IsAuthenticated)
    {
            <div class="mt-4">
                <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg me-2">Вход в систему</a>
            </div>
    }
</div>