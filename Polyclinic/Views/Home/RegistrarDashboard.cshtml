@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Панель регистратора";
}

<div class="container">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Управление пациентами</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Добавление и редактирование информации о пациентах.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Patient" asp-action="Index" class="btn btn-primary mb-2">
                            <i class="fas fa-users"></i> Список пациентов
                        </a>
                        <a asp-controller="Patient" asp-action="Create" class="btn btn-success mb-2">
                            <i class="fas fa-user-plus"></i> Добавить пациента
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Записи на прием</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Создание и управление записями на прием к врачам.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Appointment" asp-action="Index" class="btn btn-primary mb-2">
                            <i class="fas fa-calendar-alt"></i> Список записей
                        </a>
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-success mb-2">
                            <i class="fas fa-calendar-plus"></i> Создать запись
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Ближайшие приемы</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.UpcomingAppointments != null && ViewBag.UpcomingAppointments.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Дата</th>
                                        <th>Время</th>
                                        <th>Пациент</th>
                                        <th>Врач</th>
                                        <th>Кабинет</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in ViewBag.UpcomingAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.AppointmentDate.ToString("dd.MM.yyyy")</td>
                                            <td>@appointment.AppointmentDate.ToString("HH:mm")</td>
                                            <td>@appointment.PatientName</td>
                                            <td>@appointment.DoctorName</td>
                                            <td>@appointment.OfficeNumber</td>
                                            <td>
                                                <span class="badge @(appointment.Status == "SCHEDULED" ? "bg-primary" :
                                                    appointment.Status == "COMPLETED" ? "bg-success" : "bg-warning")">
                                                    @appointment.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Ближайших приемов нет.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Поиск пациента</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Patient" asp-action="Index" method="get" class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Фамилия пациента..." />
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-search"></i> Поиск
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Статистика</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <h4>@ViewBag.TodayAppointmentsCount</h4>
                            <small>Сегодня</small>
                        </div>
                        <div class="col-4">
                            <h4>@ViewBag.WeekAppointmentsCount</h4>
                            <small>За неделю</small>
                        </div>
                        <div class="col-4">
                            <h4>@ViewBag.TotalPatients</h4>
                            <small>Пациентов</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>