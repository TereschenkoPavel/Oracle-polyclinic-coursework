@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Подтверждение выхода";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning">
                <h3 class="mb-0"><i class="fas fa-sign-out-alt"></i> @ViewData["Title"]</h3>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <i class="fas fa-question-circle fa-4x text-warning mb-3"></i>
                    <h4>Вы уверены, что хотите выйти?</h4>
                    <p class="text-muted">Текущая сессия будет завершена, и вам потребуется снова войти в систему.</p>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <form asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-lg me-2">
                            <i class="fas fa-sign-out-alt"></i> Да, выйти
                        </button>
                    </form>
                    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Нет, остаться
                    </a>
                </div>
            </div>
            <div class="card-footer text-center text-muted">
                <small>Текущий пользователь: @User.Identity.Name</small>
            </div>
        </div>
    </div>
</div>