@using Clinic.Models;
@model AppointmentModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Детали записи на прием";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5>Основная информация</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-4">ID записи:</dt>
                                    <dd class="col-sm-8">@Model.AppointmentId</dd>

                                    <dt class="col-sm-4">Статус:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.Status == "SCHEDULED")
                                        {
                                            <span class="badge bg-primary">Запланирован</span>
                                        }
                                        else if (Model.Status == "COMPLETED")
                                        {
                                            <span class="badge bg-success">Завершен</span>
                                        }
                                        else if (Model.Status == "CANCELLED")
                                        {
                                            <span class="badge bg-danger">Отменен</span>
                                        }
                                        else if (Model.Status == "RESCHEDULED")
                                        {
                                            <span class="badge bg-warning">Перенесен</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Дата и время:</dt>
                                    <dd class="col-sm-8">@Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</dd>

                                    <dt class="col-sm-4">Продолжительность:</dt>
                                    <dd class="col-sm-8">@Model.DurationMinutes минут</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5>Информация о враче</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-4">Врач:</dt>
                                    <dd class="col-sm-8">@Model.DoctorName</dd>

                                    <dt class="col-sm-4">Специальность:</dt>
                                    <dd class="col-sm-8">@Model.SpecialtyName</dd>

                                    <dt class="col-sm-4">Кабинет:</dt>
                                    <dd class="col-sm-8">@Model.OfficeNumber</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5>Информация о пациенте</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-4">Пациент:</dt>
                                    <dd class="col-sm-8">@Model.PatientName</dd>

                                    <dt class="col-sm-4">Телефон:</dt>
                                    <dd class="col-sm-8">@Model.Phone</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header bg-light">
                                <h5>Действия</h5>
                            </div>
                            <div class="card-body">
                                <div class="btn-group" role="group">
           
                                    <a asp-action="Delete" asp-route-id="@Model.AppointmentId"
                                       class="btn btn-danger me-2">
                                        <i class="fas fa-times"></i> Отменить
                                    </a>
                                    @if (User.IsInRole("HEAD_DOCTOR") && Model.Status == "SCHEDULED")
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@Model.AppointmentId" />
                                            <input type="hidden" name="status" value="COMPLETED" />
                                            <button type="submit" class="btn btn-success">
                                                <i class="fas fa-check"></i> Отметить как завершенный
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Назад к списку
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>