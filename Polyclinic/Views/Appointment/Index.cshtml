@using Clinic.Models;
@model AppointmentModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Записи на прием";
    var appointments = ViewBag.Appointments as List<AppointmentModel> ?? new List<AppointmentModel>();
}

<h1>Записи на прием</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Фильтры</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Врач</label>
                <select name="doctorId" class="form-select" onchange="this.form.submit()">
                    <option value="">Выберите врача</option>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <option value="@doctor.DoctorId" selected="@(ViewBag.DoctorId?.ToString() == doctor.DoctorId.ToString())">
                            @doctor.FullName (@doctor.Specialty)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Дата</label>
                <input type="date" name="searchDate" class="form-control"
                       value="@ViewBag.SearchDate" onchange="this.form.submit()" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-secondary me-2">Сбросить</a>
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> Новая запись
                </a>
            </div>
        </form>
    </div>
</div>

@if (appointments.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th>Время</th>
                    <th>Пациент</th>
                    <th>Врач</th>
                    <th>Специальность</th>
                    <th>Кабинет</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in appointments.OrderBy(a => a.AppointmentDate))
                {
                    <tr>
                        <td>
                            <strong>@appointment.AppointmentDate.ToString("HH:mm")</strong>
                            <div class="text-muted small">@appointment.AppointmentDate.ToString("dd.MM.yyyy")</div>
                        </td>
                        <td>
                            <div>@appointment.PatientName</div>
                            <small class="text-muted">@appointment.Phone</small>
                        </td>
                        <td>@appointment.DoctorName</td>
                        <td>@appointment.SpecialtyName</td>
                        <td>@appointment.OfficeNumber</td>
                        <td>
                            @if (appointment.Status == "SCHEDULED")
                            {
                                <span class="badge bg-primary">Запланирован</span>
                            }
                            else if (appointment.Status == "COMPLETED")
                            {
                                <span class="badge bg-success">Завершен</span>
                            }
                            else if (appointment.Status == "CANCELLED")
                            {
                                <span class="badge bg-danger">Отменен</span>
                            }
                            else if (appointment.Status == "RESCHEDULED")
                            {
                                <span class="badge bg-warning">Перенесен</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Details" asp-route-id="@appointment.AppointmentId"
                                   class="btn btn-outline-info" title="Подробнее">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@appointment.AppointmentId"
                                   class="btn btn-outline-danger" title="Отменить">
                                    <i class="fas fa-times"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-calendar-times"></i> На выбранную дату записей не найдено.
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Автоматическое обновление статуса при выборе врача или даты
            $('select[name="doctorId"], input[name="searchDate"]').on('change', function() {
                $(this).closest('form').submit();
            });
        });
    </script>
}